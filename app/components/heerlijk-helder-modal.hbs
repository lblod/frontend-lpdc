<AuModal
  class="modal-height-fit-content"
  @modalOpen={{true}}
  @closeModal={{this.close}}
  @size="large"
>
  <:title>Maak je tekst Heerlijk Helder</:title>
  <:body>
    <div class="au-o-grid">
      <p class="au-o-grid__item">Genereer een Heerlijk Heldere tekst op basis
        van de originele tekst in het veld. Lees de tekst na en maak
        aanpassingen waar nodig</p>

      <div class="au-o-grid__item">
        <div class="heerlijk-helder-compare">
          <div class="au-u-flex au-u-flex--vertical-end">
            <AuLabel for="hh-original">{{@data.fieldLabel}}</AuLabel>
          </div>
          <span></span>
          <div class="au-u-flex au-u-flex--between au-u-flex--vertical-end">
            <AuLabel for="hh-generated">
              {{@data.fieldLabel}}
              <AuIcon
                @icon="ai-write"
                @size="large"
                class="au-u-margin-left-tiny"
              />
            </AuLabel>
            <div class="au-u-flex au-u-flex--column au-u-flex--vertical-end">
              <AuButton
                @icon="undo"
                @skin="link-secondary"
                @alert="true"
                @disabled={{not this.canRevert}}
                {{on "click" this.revertGeneration}}
              >Herstellen</AuButton>
              <AuButton
                @icon="ai-write"
                @skin="link"
                @disabled={{this.isBusy}}
                {{on "click" (perform this.generate)}}
              >Opnieuw proberen</AuButton>
            </div>
          </div>

          {{#if @data.editor}}
            <AuContent
              @skin="tiny"
              id="hh-original"
              class="rich-text-editor-content"
            >
              {{! template-lint-disable no-triple-curlies}}
              {{{this.firstOriginal}}}
            </AuContent>
          {{else}}
            <AuTextarea
              id="hh-original"
              @width="block"
              @disabled={{true}}
              rows="8"
              value={{this.firstOriginal}}
            />
          {{/if}}
          <AuIcon
            @icon="arrow-right"
            @size="large"
            class="au-u-flex-self-center"
          />
          {{#if this.isBusy}}
            <div
              class="au-c-textarea au-c-textarea--block au-u-flex au-u-flex--center au-u-flex--vertical-center au-u-italic au-u-muted"
            >
              <AuLoader @centered={{true}}>
                Heerlijk Helder aan het werk…
              </AuLoader>
            </div>
          {{else if this.error}}
            <AuAlert @icon="cross" @skin="error" @size="small">
              <AuContent @skin="small">
                Er ging iets mis bij het genereren van de tekst. Probeer het
                opnieuw.
              </AuContent>
            </AuAlert>
          {{else if @data.editor}}
            <div
              id="hh-generated"
              class="rich-text-editor"
              {{on "input" this.updateDraftFromEditor}}
              {{on "focusout" this.updateDraftFromEditor}}
            >
              <EditorContainer>
                <:top>
                  <ResponsiveToolbar>
                    <:main as |Tb|>
                      <Tb.Group>
                        <Plugins::Heading::HeadingMenu
                          @controller={{this.editorController}}
                        />
                      </Tb.Group>
                      <Tb.Group>
                        <Plugins::TextStyle::Bold
                          @controller={{this.editorController}}
                        />
                        <Plugins::TextStyle::Italic
                          @controller={{this.editorController}}
                        />
                        <RdfFormFields::RichTextEditor::ExtraFormattingOptions
                          @controller={{this.editorController}}
                        />
                      </Tb.Group>
                      <Tb.Group>
                        <Plugins::List::Unordered
                          @controller={{this.editorController}}
                        />
                        <Plugins::List::Ordered
                          @controller={{this.editorController}}
                        />
                      </Tb.Group>
                      <Tb.Group>
                        <Plugins::Link::LinkMenu
                          @controller={{this.editorController}}
                        />
                      </Tb.Group>
                      <Tb.Group>
                        <Plugins::Table::TableMenu
                          @controller={{this.editorController}}
                        />
                        <Plugins::Table::Color
                          @controller={{this.editorController}}
                        />
                        <Plugins::Table::VerticalAlign
                          @controller={{this.editorController}}
                        />
                      </Tb.Group>
                    </:main>
                  </ResponsiveToolbar>
                </:top>
                <:default>
                  <Editor
                    @schema={{@data.editor.schema}}
                    @plugins={{@data.editor.plugins}}
                    @nodeViews={{@data.editor.nodeViews}}
                    @rdfaEditorInit={{this.initEditor}}
                  />
                </:default>
              </EditorContainer>
            </div>
          {{else}}
            <AuTextarea
              id="hh-generated"
              @width="block"
              rows="8"
              value={{this.draft}}
              {{on "input" this.updateDraft}}
            />
          {{/if}}
        </div>

        <p class="au-u-text-right au-u-margin-top-tiny">
          Is er iets mis met de gegenereerde tekst?<br />
          <AuLinkExternal
            href="mailto:LoketLokaalBestuur@vlaanderen.be?subject=Heerlijk%20Helder"
          >Meld het</AuLinkExternal>
        </p>
      </div>
      <div
        class="au-o-grid__item au-u-flex au-u-flex--column au-u-flex--vertical-center"
      >
        Tevreden met het resultaat?
        <AuButtonGroup>

          <AuButton
            @skin="naked"
            @size="large"
            {{on "click" (fn this.rateRewrite true)}}
          >
            <VoteThumbsUpIcon
              @fill={{if (eq this.activity.isImproved true) "#0055CC"}}
            />
          </AuButton>
          <AuButton
            @skin="naked"
            @size="large"
            {{on "click" (fn this.rateRewrite false)}}
          >
            <VoteThumbsDownIcon
              @fill={{if (eq this.activity.isImproved false) "#0055CC"}}
            />
          </AuButton>
        </AuButtonGroup>
      </div>
    </div>

  </:body>
  <:footer>
    <AuButtonGroup>
      <AuButton
        @disabled={{not this.canSave}}
        @loading={{this.save.isRunning}}
        {{on "click" (perform this.save)}}
      >
        Opslaan
      </AuButton>
      <AuButton @skin="secondary" {{on "click" this.close}}>
        Annuleren
      </AuButton>
    </AuButtonGroup>
  </:footer>
</AuModal>