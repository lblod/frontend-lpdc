<AuModal
  class="modal-height-fit-content"
  @modalOpen={{true}}
  @closeModal={{this.close}}
  @size="large"
>
  <:title>Maak je tekst Heerlijk Helder</:title>
  <:body>
    <div class="au-o-grid">
      <p class="au-o-grid__item">Genereer een Heerlijk Heldere tekst op basis
        van de originele tekst in het veld. Lees de tekst na en maak
        aanpassingen waar nodig</p>

      <div class="au-o-grid__item">
        <div class="heerlijk-helder-compare">
          {{! row 1: labels }}
          <div class="au-u-flex au-u-flex--vertical-end">
            <AuLabel for="hh-original">{{@data.fieldLabel}}</AuLabel>
          </div>
          <span></span>
          <div class="au-u-flex au-u-flex--between au-u-flex--vertical-end">
            <AuLabel for="hh-generated">
              {{@data.fieldLabel}}
              <AuIcon
                @icon="ai-write"
                @size="large"
                class="au-u-margin-left-tiny"
              />
            </AuLabel>
            <div class="au-u-flex au-u-flex--column au-u-flex--vertical-end">
              <AuButton
                @icon="undo"
                @skin="link-secondary"
              >Herstellen</AuButton>
              <AuButton
                @icon="ai-write"
                @skin="link-secondary"
                @disabled={{this.loadOrGenerate.isRunning}}
                {{on "click" this.regenerate}}
              >Opnieuw proberen</AuButton>
            </div>
          </div>

          {{! row 2: original -> generated (grid stretches both to the same height) }}
          <AuTextarea
            id="hh-original"
            @width="block"
            @disabled={{true}}
            rows="8"
            value={{this.originalValue}}
          />
          <AuIcon
            @icon="arrow-right"
            @size="large"
            class="au-u-flex-self-center"
          />
          {{#if this.loadOrGenerate.isRunning}}
            <div
              class="au-c-textarea au-c-textarea--block au-u-flex au-u-flex--center au-u-flex--vertical-center au-u-italic au-u-muted"
            >
              <AuLoader @centered={{true}}>
                Heerlijk Helder aan het werk…
              </AuLoader>
            </div>
          {{else}}
            <AuTextarea
              id="hh-generated"
              @width="block"
              rows="8"
              value={{this.generation}}
              {{on "input" this.updateGeneration}}
            />
          {{/if}}
        </div>

        <p class="au-u-text-right au-u-margin-top-tiny">
          Is er iets mis met de gegenereerde tekst?<br />
          <AuLinkExternal
            href="mailto:LoketLokaalBestuur@vlaanderen.be?subject=Heerlijk Helder"
          >Meld het</AuLinkExternal>
        </p>
      </div>
      <div
        class="au-o-grid__item au-u-flex au-u-flex--column au-u-flex--vertical-center"
      >
        Tevreden met het resultaat?
        <AuButtonGroup>

          <AuButton
            @skin="naked"
            @size="large"
            {{on "click" (fn this.rateRewrite true)}}
          >
            <VoteThumbsUpIcon
              @fill={{if (eq this.isImproved true) "#0055CC"}}
            />
          </AuButton>
          <AuButton
            @skin="naked"
            @size="large"
            {{on "click" (fn this.rateRewrite false)}}
          >
            <VoteThumbsDownIcon
              @fill={{if (eq this.isImproved false) "#0055CC"}}
            />
          </AuButton>
        </AuButtonGroup>
      </div>
    </div>

  </:body>
  <:footer>
    <AuButtonGroup>
      <AuButton {{on "click" this.save}}>
        Opslaan
      </AuButton>
      <AuButton @skin="secondary" {{on "click" this.close}}>
        Annuleren
      </AuButton>
    </AuButtonGroup>
  </:footer>
</AuModal>