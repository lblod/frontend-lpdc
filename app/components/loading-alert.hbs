{{#if this.isVisible}}
  <div
    class="au-c-alert {{this.skin}} {{this.size}}"
    role="alert"
    data-test-alert
    ...attributes
  >
    <AuLoader @inline={{true}} @centered={{false}} @hideMessage={{true}} class="au-u-margin-right-small">
      {{! The loader component is not intended to be used without a loading message, so we use this as a workaround }}
      &nbsp;
    </AuLoader>
    <div class="au-c-alert__content">
      {{#if @title}}
        <p class="au-c-alert__title" data-test-alert-title>{{@title}}</p>
      {{/if}}
      <div class="au-c-alert__message" data-test-alert-message>{{yield}}</div>
    </div>
    {{#if @closable}}
      <button
        class="au-c-alert__close"
        type="button"
        data-test-alert-close
        {{on "click" this.closeAlert}}
      >
        <AuIcon @icon="cross" @size="large" />
        {{! template-lint-disable no-bare-strings }}
        <span class="au-u-hidden-visually">Sluit alert</span>
      </button>
    {{/if}}
  </div>
{{/if}}