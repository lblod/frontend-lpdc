{{#if this.visible}}
  <AuButton
    {{! @icon="alert-triangle" }}
    @skin="link"
    class="au-u-margin-tiny"
    {{on "click" this.openModal}}
  >
    <AuIcon
      @size="large"
      @icon={{if this.isConceptTakenOver "check" "alert-triangle"}}
    />
    {{#if this.isConceptTakenOver}}
      Wijzigingen overgenomen
    {{else}}
      Conceptwijzigingen bekijken
    {{/if}}
  </AuButton>
{{/if}}