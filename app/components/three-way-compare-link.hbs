{{#if this.visible}}
  <AuButton
    @icon={{if this.isConceptTakenOver "check" "copy"}}
    @skin="link"
    class="au-u-margin-tiny"
    {{on "click" this.openModal}}
  >
    {{#if this.isConceptTakenOver}}
      Wijzigingen overgenomen
    {{else}}
      Conceptwijzigingen overnemen
    {{/if}}
  </AuButton>
{{/if}}