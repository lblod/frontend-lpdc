{{page-title @model.publicService.name}}

<SidebarContainer>
  <:sidebar>
    <div class="au-o-box au-o-box--small">
      {{#if this.shouldShowContentGeneratedWarning}}
        <GeneratedContentWarning
          @languageVersion={{@model.languageVersionOfConcept}}
          @conceptName={{@model.publicService.concept.nameNl}}
          @conceptProductId={{@model.publicService.concept.productId}}
        />
      {{/if}}

      <DataList @vertical={{true}} as |Data|>
        <Data>
          <:title>IPDC Concept ID</:title>
          <:content>
            {{#if @model.publicService.concept.id}}
              <AuLink
                @route="public-services.concept-details"
                @model={{@model.publicService.concept.id}}
                target="blank"
              >
                {{@model.publicService.concept.productId}}
              </AuLink>
            {{else if this.canLinkConcept}}
              <AuLink
                @icon="link"
                @route="public-services.link-concept"
                @model={{@model.publicService.id}}
              >
                Koppelen
              </AuLink>
            {{else}}
              <ValueWithPlaceholder @value={{false}} />
            {{/if}}
            {{#if this.canUnlinkConcept}}
              <AuButton
                @alert={{true}}
                @icon="link-broken"
                @skin="link"
                {{on "click" this.showUnlinkWarning}}
              >
                Loskoppelen
              </AuButton>
            {{/if}}
            {{#if this.shouldShowUnlinkWarning}}
              <AuAlert
                @skin="error"
                @size="small"
                @closable={{this.unlinkConcept.isIdle}}
                @onClose={{this.hideUnlinkWarning}}
                class="au-u-margin-top au-u-max-width-small"
              >
                <p class="au-u-margin-top-tiny">
                  Wil je de instantie loskoppelen van het concept? Je krijgt dan
                  niet langer meldingen over wijzigingen aan het concept. Je kan
                  een instantie op elk moment opnieuw koppelen aan een concept.
                </p>
                <AuButton
                  @icon="link-broken"
                  @alert={{true}}
                  @loading={{this.unlinkConcept.isRunning}}
                  @loadingMessage="Aan het loskoppelen"
                  {{on "click" (perform this.unlinkConcept)}}
                >Loskoppelen
                </AuButton>
              </AuAlert>
            {{/if}}
          </:content>
        </Data>
        <Data>
          <:title>
            <span class="au-u-flex au-u-flex--between">
              Relevante brondocumenten
              {{#if this.linkedDecisions.length}}
                <AuButton
                  @icon="pencil"
                  @skin="link"
                  class="au-u-flex-shrink-0"
                  {{on "click" this.linkDecision}}
                >Bewerken</AuButton>
              {{/if}}
            </span>
          </:title>
          <:content>
            <div class="au-u-flex au-u-flex--column">
              {{#if this.linkedDecisions.length}}
                <AuButton
                  @skin="link"
                  {{on "click" this.openDecisionView}}
                >{{this.linkedDecisions.length}}
                  {{if
                    (eq this.linkedDecisions.length 1)
                    "brondocument"
                    "brondocumenten"
                  }}</AuButton>
              {{else}}
                <AuButton
                  @icon="link"
                  @skin="link"
                  {{on "click" this.linkDecision}}
                >Koppelen</AuButton>
              {{/if}}
            </div>
          </:content>
        </Data>
        <Data>
          <:title>Producttype</:title>
          <:content>
            <span class="au-u-muted">
              <ValueWithPlaceholder
                @value={{@model.publicService.type.label}}
              />
            </span>
          </:content>
        </Data>
        <Data>
          <:title>Aangemaakt op</:title>
          <:content>
            <span class="au-u-muted">
              <ValueWithPlaceholder @value={{@model.publicService.dateCreated}}>
                <:value as |value|>
                  {{moment-format value}}
                </:value>
              </ValueWithPlaceholder>
            </span>
          </:content>
        </Data>
        <Data>
          <:title>Aangemaakt door</:title>
          <:content>
            <span class="au-u-muted">
              {{#if @model.publicService.creator}}
                {{@model.publicService.creator.fullName}}
              {{else}}
                –
              {{/if}}
            </span>
          </:content>
        </Data>
        <Data>
          <:title>Bewerkt op</:title>
          <:content>
            <span class="au-u-muted">
              <ValueWithPlaceholder
                @value={{@model.publicService.dateModified}}
              >
                <:value as |value|>
                  {{moment-format value}}
                </:value>
              </ValueWithPlaceholder>
            </span>
          </:content>
        </Data>
        <Data>
          <:title>Bewerkt door</:title>
          <:content>
            <span class="au-u-muted">
              {{#if @model.publicService.lastModifier}}
                {{@model.publicService.lastModifier.fullName}}
              {{else}}
                –
              {{/if}}
            </span>
          </:content>
        </Data>
        <Data>
          <:title>Aanvraagbaar van</:title>
          <:content>
            <span class="au-u-muted">
              <ValueWithPlaceholder @value={{@model.publicService.startDate}}>
                <:value as |value|>
                  {{moment-format value "DD-MM-YYYY"}}
                </:value>
              </ValueWithPlaceholder>
            </span>
          </:content>
        </Data>
        <Data>
          <:title>Aanvraagbaar tot en met</:title>
          <:content>
            <span class="au-u-muted">
              <ValueWithPlaceholder @value={{@model.publicService.endDate}}>
                <:value as |value|>
                  {{moment-format value "DD-MM-YYYY"}}
                </:value>
              </ValueWithPlaceholder>
            </span>
          </:content>
        </Data>
        <Data>
          <:title>Status</:title>
          <:content>
            {{#if @model.publicService.status.label}}
              <Status @uri={{@model.publicService.status.uri}}>
                {{@model.publicService.status.label}}
              </Status>
            {{else}}
              –
            {{/if}}
          </:content>
        </Data>
        {{#if this.shouldDisplayVersion}}
          <Data>
            <:title>Versie</:title>
            <:content>
              <span class="au-u-muted">
                {{this.publicServiceDutchLanguageVariant}}
              </span>
            </:content>
          </Data>
        {{/if}}
      </DataList>
    </div>
  </:sidebar>

  <:content>
    <SidebarContainer
      @size={{if this.isDecisionViewOpen "large" "medium"}}
      @collapsed={{not (or this.isFeedbackOpen this.isDecisionViewOpen)}}
      @reverse={{true}}
      @hidden={{not (or this.hasFeedback this.isDecisionViewOpen)}}
    >
      <:content>
        {{outlet}}
      </:content>
      <:sidebar>
        <div class="au-u-flex au-u-height-full">
          {{#if this.isFeedbackOpen}}
            <div class="au-u-padding-top-small">
              <div
                class="au-u-flex au-u-flex--vertical-baseline au-u-padding-bottom-small u-border-divider u-border-divider--bottom"
              >
                <AuButton
                  @skin="link-secondary"
                  @size="large"
                  class="au-u-flex-shrink-0"
                  {{on "click" this.toggleFeedbackSidebar}}
                >
                  <AuIcon @size="large" @icon="nav-right" />
                </AuButton>
                <div class="au-u-margin-right-small">
                  <div class="au-u-flex au-u-flex--between">
                    <AuHeading @skin="3" @level="2">Feedback</AuHeading>
                    <AuToggleSwitch
                      @checked={{this.includeFeedbackHistory}}
                      @onChange={{this.toggleIncludeFeedbackHistory}}
                    >
                      Inclusief historiek
                    </AuToggleSwitch>
                  </div>
                  <p class="au-u-para-small">Verwerk de gekregen feedback door
                    je product te bewerken of door de feedback te weigeren.
                    Verzend daarna je antwoord.
                  </p>
                </div>
              </div>
              {{#if this.loadFeedback.isRunning}}
                <p class="au-u-text-center au-u-margin">Feedback aan het laden</p>
              {{else if this.loadFeedback.last.value}}
                {{#each this.loadFeedback.last.value as |feedbackItem index|}}
                  <Feedback @feedback={{feedbackItem}} @index={{index}} />
                {{/each}}
              {{else}}
                <p class="au-u-text-center au-u-margin">Geen feedback
                  beschikbaar</p>
              {{/if}}
            </div>
          {{else if this.hasFeedback}}
            <div
              class="au-u-padding-top
                {{if
                  this.isDecisionViewOpen
                  'u-border-divider u-border-divider--right'
                }}"
            >
              <AuTooltip @placement="bottom" as |tooltip|>
                <AuButton
                  @skin="link-secondary"
                  @size="large"
                  class="au-u-flex-shrink-0"
                  {{tooltip.target}}
                  {{on "click" this.toggleFeedbackSidebar}}
                >
                  <AuIcon @size="large" @icon="nav-left" />
                </AuButton>
                <tooltip.Content>
                  Feedback beschikbaar
                </tooltip.Content>
              </AuTooltip>
            </div>
          {{/if}}

          {{#if this.isDecisionViewOpen}}
            <DecisionDetail
              @publicService={{@model.publicService}}
              @decisions={{this.linkedDecisions}}
              @onClose={{this.closeDecisionView}}
            />
          {{/if}}
        </div>
      </:sidebar>
    </SidebarContainer>
  </:content>
</SidebarContainer>