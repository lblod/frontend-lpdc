{
  "name": "frontend-lpdc",
  "version": "0.34.2",
  "private": true,
  "description": "Frontend LPDC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lblod/frontend-lpdc.git"
  },
  "license": "MIT",
  "author": {
    "name": "Agentschap Binnenlands Bestuur",
    "url": "https://www.vlaanderen.be/agentschap-binnenlands-bestuur"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "postinstall": "patch-package",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint --allow-empty-input \"**/*.scss\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:dependencies": "ember dependency-lint",
    "release": "release-it",
    "start": "ember serve",
    "start:local": "ember serve --proxy http://localhost:90",
    "start:local-test": "ember serve --proxy http://localhost:96",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test"
  },
  "overrides": {
    "@ember/test-waiters": "^4.1.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-modifier": "^4.3.0",
    "tracked-toolbox": "^3.0.0"
  },
  "overridesComments": {
    "ember-modifier": "promise-modals pinned the version to 4.2.2 by accident: https://github.com/mainmatter/ember-promise-modals/pull/1063",
    "tracked-toolbox": "rdfa-editor depends on v2, and appuniversum on v3. We can safely force v3 because our app is on a new enough ember version"
  },
  "devDependencies": {
    "@appuniversum/ember-appuniversum": "^4.4.1",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@ember/optional-features": "^2.3.0",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.2",
    "@eslint/js": "^9.39.4",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@lblod/ember-acmidm-login": "^2.3.0",
    "@lblod/ember-mock-login": "^0.14.0",
    "@lblod/ember-rdfa-editor": "^13.19.1",
    "@lblod/ember-submission-form-fields": "^3.8.0",
    "@lblod/submission-form-helpers": "^3.1.0",
    "@sentry/ember": "^7.54.0",
    "@warp-drive/core": "~5.8.1",
    "@warp-drive/json-api": "~5.8.1",
    "@warp-drive/legacy": "~5.8.1",
    "@warp-drive/utilities": "~5.8.1",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.2.1",
    "date-fns": "^2.28.0",
    "ember-auto-import": "^2.13.1",
    "ember-basic-dropdown": "^8.11.0",
    "ember-cli": "~6.12.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-dependency-lint": "^2.0.1",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-moment-shim": "^3.8.0",
    "ember-cli-sass": "^11.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-concurrency": "^5.2.0",
    "ember-data": "~5.8.1",
    "ember-intl": "^7.0.0",
    "ember-load-initializers": "^3.0.1",
    "ember-lodash": "^4.19.5",
    "ember-modifier": "^4.3.0",
    "ember-moment": "^9.0.0",
    "ember-mu-transform-helpers": "^2.1.2",
    "ember-page-title": "^9.0.3",
    "ember-plausible": "^0.2.0",
    "ember-power-select": "^8.12.1",
    "ember-power-select-with-create": "^3.1.0",
    "ember-promise-helpers": "^2.0.0",
    "ember-promise-modals": "^5.0.0",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-simple-auth": "^8.4.1",
    "ember-source": "~6.12.0",
    "ember-template-imports": "^4.4.0",
    "ember-template-lint": "^6.1.0",
    "ember-test-selectors": "^6.0.0",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-warp-drive": "^5.8.1",
    "globals": "^15.15.0",
    "loader.js": "^4.7.0",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.32",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.4",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "rdflib": "^2.2.19",
    "release-it": "^16.1.3",
    "sass": "^1.49.7",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "validator": "^13.15.15",
    "webpack": "^5.106.0"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  },
  "lintTodo": {
    "ember-template-lint": {
      "daysToDecay": null
    }
  }
}
